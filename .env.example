# ── Auth (Auth.js / NextAuth v5, Google) ───────────────────────────────
# Leave AUTH_GOOGLE_ID unset to run in DEMO mode (no login, opens as a TL/manager
# with an in-app "Signed in as" role switcher). Set all three to turn on real login.
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000    # https://<app>.vercel.app in production

# ── Postgres ────────────────────────────────────────────────────────────
# Leave unset to run on the bundled sample roster (lib/sample.ts).
# Set it (Vercel Postgres / Neon / Supabase) to read/write real shared state.
DATABASE_URL=

# ── Google Sheets sync (service account) ─────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_KEY=       # base64 of the service-account JSON key
SHEET_LRM_BAND_ID=18-CHBpyH6pTPwp2LmFnhwTy8t78_PbCjc0mraNX5w_E
SHEET_LRM_BAND_RANGE=Today's Plan!A1:ZZ400

# ── Cron protection ───────────────────────────────────────────────────────
CRON_SECRET=
